{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "../../..",
    "sourceMap": true
  },
  "include": ["**/*.ts", "../../shared/**/*.ts", "../../../frontend/types/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
