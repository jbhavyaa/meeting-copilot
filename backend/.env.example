# These values are stored in AWS Secrets Manager under the key "meeting-copilot/secrets".
# Run: aws secretsmanager create-secret --name meeting-copilot/secrets --secret-string '{...}'
# with a JSON object containing each key below.

RECALL_API_KEY= 452f87e99c0bb0309a420122929b36e7a518e2b3
ASSEMBLYAI_API_KEY= 0af2996b889441cd8ef8a6e100aea10d
RECALL_WEBHOOK_SECRET=    # A random secret you set when registering the webhook in Recall
OPENAI_API_KEY=           # https://platform.openai.com/api-keys (used only for Whisper)
ANTHROPIC_API_KEY=        # https://console.anthropic.com → API Keys
SUPABASE_URL= https://sknkihrqdqeswsdzmsva.supabase.co
SUPABASE_SERVICE_ROLE_KEY=# Supabase Settings → API → service_role key
RESEND_API_KEY=           # https://resend.com → API Keys
GOOGLE_CALENDAR_WEBHOOK_TOKEN=  # A random token you choose; used to validate Google push notifications

# Lambda environment variables (set in CDK or manually in the console)
PROCESSING_QUEUE_URL=     # Output from CDK deploy: MeetingCopilotStorage.ProcessingQueueUrl
AUDIO_BUCKET_NAME=        # Output from CDK deploy: MeetingCopilotStorage.AudioBucketName
WHISPER_ENDPOINT=         # Output from CDK deploy: MeetingCopilotCompute.WhisperEndpoint
JIRA_PROJECT_KEY=         # The short key of your Jira project, e.g. PROJ
APP_SECRETS_NAME=meeting-copilot/secrets
